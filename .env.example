# Sportelemző – opcionális beállítások. Másold .env néven, és csak azt töltsd ki, amit használni szeretnél.
# Kulcs nélkül is minden működik (ESPN kulcs nélküli végpontok + mintaadat-tartalék).

# --- Opcionális, ingyenes csomagos API-kulcsok ---
# The Odds API – fogadóirodai szorzók (https://the-odds-api.com, ingyenes: 500 kredit/hó)
THE_ODDS_API_KEY=
# API-Sports (API-Football) – sérülések, eltiltások (https://api-sports.io, ingyenes: 100 kérés/nap)
API_SPORTS_KEY=
# football-data.org – tabellák, gólstatisztika (https://www.football-data.org, ingyenes: 10 kérés/perc)
FOOTBALL_DATA_KEY=

# --- Adatmód ---
# auto = élő források, hiba esetén bajnokságonként mintaadat | mock = csak mintaadat, hálózat nélkül | live
DATA_MODE=
# PORT=3000
# LAN=off                      # on = telefonos elérés a Wi-Fin (ugyanaz, mint: npm run telefon)
# ACCESS_PIN=                  # saját 6 jegyű PIN a telefonos belépéshez (különben véletlen, data/local-secrets.json)
# HOST=127.0.0.1

# --- Szolgáltatók egyenkénti ki/bekapcsolása (on/off) ---
# PROVIDER_ESPN=
# PROVIDER_ODDSAPI=
# PROVIDER_APISPORTS=
# PROVIDER_FOOTBALLDATA=
# PROVIDER_WEATHER=

# --- The Odds API kvótakímélés ---
# ODDS_API_MARKETS=h2h            # h2h,totals = 2 kredit/kérés
# ODDS_API_TTL_HOURS=12
# ODDS_API_DAILY_CREDITS=15

# --- Frissítési ütemezés (másodperc) ---
# REFRESH_LIVE_SECONDS=45
# REFRESH_FIXTURES_SECONDS=600

# --- Tétméretezés alapértékei ---
# KELLY_FRACTION=0.25
# KELLY_CAP=0.05

# --- Egyéb ---
# LOG_LEVEL=info                   # debug | info | warn | error
# HTTP_TIMEOUT_MS=8000
# DATA_DIR=data
